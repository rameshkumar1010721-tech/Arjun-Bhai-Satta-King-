  <!-- Optional: small script to let you quickly edit numbers from browser console -->
  <script>
    // Use this to quickly set results from browser console:
    // Example: setResult(1,'45')
    function setResult(i,val){ const el = document.getElementById('r'+i); if(el) el.textContent = val; }
    // Preload: you can set default sample values (commented)
    // setResult(1,'--'); setResult(2,'--');
  </script>
</body>
</html>
